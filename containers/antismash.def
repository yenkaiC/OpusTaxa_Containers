Bootstrap: docker
From: condaforge/miniforge3:latest

%labels
    Author OpusTaxa
    Tool antismash
    Version 8.0.4

%post
    apt-get update && apt-get install -y procps && apt-get clean -y
    mamba install -y -c conda-forge -c bioconda \
        python=3.12 \
        antismash=8.0.4

    # Prepare the bundled detection HMMs (bgc_seeds.hmm etc.) in-place NOW,
    # while the image filesystem is writable. Uses the official antiSMASH
    # Dockerfile approach: a placeholder --databases value so config can be
    # built without the large downloadable databases present. Those are still
    # fetched at runtime via download-antismash-databases --database-dir.
    python3 -c "import antismash; antismash.config.build_config(['--databases', 'mounted_at_runtime'], modules=antismash.get_all_modules()); antismash.main.prepare_module_data()"

    mamba clean -a -y

%environment
    export PATH=/opt/conda/bin:$PATH

%runscript
    exec "$@"