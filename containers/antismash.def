Bootstrap: docker
From: condaforge/miniforge3:latest

%labels
    Author OpusTaxa
    Tool antismash
    Version 8.0.4

%post
    apt-get update && apt-get install -y procps && apt-get clean -y
    mamba install -y -c conda-forge -c bioconda \
        python=3.12 \
        antismash=8.0.4

    # Press the bundled detection HMMs (bgc_seeds.hmm etc.) into the package
    # data dir NOW, while the image filesystem is still writable. At runtime the
    # .sif is read-only, so this in-package preparation must happen at build time.
    antismash --prepare-data

    mamba clean -a -y

%environment
    export PATH=/opt/conda/bin:$PATH

%runscript
    exec "$@"